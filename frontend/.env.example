# demo = data & business rule berjalan di browser (GitHub Pages, review user)
# http = memanggil AMS API (.NET) di /api/v1
VITE_API_MODE=demo
# Base URL API untuk mode http (kosong = origin yang sama, lewat reverse proxy IIS / proxy Vite)
VITE_API_BASE=
# mock = pilih user seed; sso = Active Directory (OIDC) – diaktifkan setelah API siap
VITE_AUTH_MODE=mock
